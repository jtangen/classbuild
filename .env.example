# ClassBuild — API keys
#
# The web app never reads environment variables: keys are entered on the
# Setup page and stay in your browser.
#
# The CLI scripts (scripts/*.ts) do read them. Copy this file to .env.local
# (gitignored) and run scripts with: npx tsx --env-file=.env.local scripts/...

# Required for course generation (generate-course.ts)
ANTHROPIC_API_KEY=

# Optional: figures and 4K slide images (OpenAI gpt-image-2)
OPENAI_API_KEY=

# Optional: audiobook narration (ElevenLabs TTS)
ELEVENLABS_API_KEY=
